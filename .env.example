# === GYM GAN – Supabase Konfiguration ===
# Kopiere diese Datei zu .env.local und trage deine Werte ein.
# Auf Vercel: Dieselben Variablen unter Project → Settings → Environment Variables setzen.
#
# So bekommst du die Werte:
# 1. Öffne https://app.supabase.com
# 2. Wähle dein Projekt (oder erstelle eins)
# 3. Project Settings → API
# 4. "Project URL"        → VITE_SUPABASE_URL
# 5. "anon public key"    → VITE_SUPABASE_ANON_KEY

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
